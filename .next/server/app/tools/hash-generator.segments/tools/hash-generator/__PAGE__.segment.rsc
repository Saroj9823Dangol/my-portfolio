n":"MD5:"}]," A widely known algorithm that produces a 128-bit hash. While very fast, it is no longer considered cryptographically secure against collision attacks and should only be used as a checksum to verify data integrity against unintentional corruption."]}],["$","li",null,{"children":[["$","strong",null,{"children":"SHA-1:"}]," Produces a 160-bit hash value. Like MD5, it is no longer considered secure for cryptographic purposes but remains in use in legacy systems and non-security critical applications like Git."]}]]}],["$","h2",null,{"className":"text-xl font-bold mb-3 mt-8 text-white","children":"Privacy Guarantee"}],["$","p",null,{"className":"mb-4 text-[var(--color-fg-muted)]","children":"All hashing calculations are performed locally in your web browser. Your text inputs are never transmitted over the internet or stored on any server."}]]}]],[["$","script","script-0",{"src":"/_next/static/chunks/b264949ad40f978d.js","async":true}]],["$","$L4",null,{"children":["$","$5",null,{"name":"Next.MetadataOutlet","children":"$@6"}]}]]}],"loading":null,"isPartial":false}
