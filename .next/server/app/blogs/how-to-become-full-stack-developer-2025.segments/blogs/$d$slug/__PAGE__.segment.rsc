0:{"buildId":"PDQeAzWPT7nHY_u-6yaOp","rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"How to Become a Full-Stack Developer in 2025: A Roadmap\",\"description\":\"A comprehensive roadmap to becoming a full-stack developer in 2025, covering essential skills, tools like the MERN stack, AI integration, and strategies to stay competitive.\",\"image\":\"https://www.sarojdangol012.com.np/images/blogs/how-to-become-full-stack-developer-2025.jpeg\",\"url\":\"https://www.sarojdangol012.com.np/blogs/how-to-become-full-stack-developer-2025\",\"datePublished\":\"2025-07-08\",\"dateModified\":\"2025-07-08\",\"author\":{\"@type\":\"Person\",\"@id\":\"https://www.sarojdangol012.com.np/#person\",\"name\":\"Saroj Dangol\",\"url\":\"https://www.sarojdangol012.com.np/about\"},\"publisher\":{\"@type\":\"Person\",\"name\":\"Saroj Dangol\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.sarojdangol012.com.np/blogs/how-to-become-full-stack-developer-2025\"},\"keywords\":\"Full-Stack Development, MERN Stack, Web Development, AI Tools, Next.js, Node.js, Career, DevOps\"}"}}],["$","div",null,{"className":"pt-16","children":["$","article",null,{"className":"py-16 max-w-3xl mx-auto px-6","children":[["$","$L2",null,{"href":"/blogs","className":"inline-flex items-center gap-2 text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] transition-colors mb-8","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true","children":[["$","path","1l729n",{"d":"m12 19-7-7 7-7"}],["$","path","x3x0zl",{"d":"M19 12H5"}],"$undefined"]}],"All posts"]}],["$","header",null,{"className":"mb-8","children":[["$","div",null,{"class